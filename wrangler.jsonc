{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "everydaykit",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/freesignal/auth/*", "/freesignal/api/*", "/slnews247/auth/*"]
  },
  "kv_namespaces": [
    { "binding": "TIKTOK_AUTH" }
  ]
}
